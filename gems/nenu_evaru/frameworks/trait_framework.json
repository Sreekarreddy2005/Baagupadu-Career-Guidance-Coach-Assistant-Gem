        "abstract_thinking": {
          "name": "Abstract Thinking",
          "description": "Enjoys concepts, ideas, and theoretical exploration",
          "tier": 2,
          "indicators": [
            "Loved thinking about complex ideas",
            "Enjoyed philosophy or theory",
            "Asked 'why' and 'what if' questions",
            "Explored concepts beyond practical use",
            "Connected abstract ideas to reality",
            "Was curious about meaning and purpose"
          ],
          "levels": [
            "Emerging",
            "Developing",
            "Strong",
            "Exceptional"
          ],
          "career_affinities": [
            "Academia",
            "Research",
            "Philosophy",
            "Strategy",
            "Design"
          ],
          "validation_prompts": [
            "Do you enjoy thinking about abstract ideas?",
            "What kind of questions fascinate you?"
          ]
        },
        "pragmatic_thinking": {
          "name": "Pragmatic Thinking",
          "description": "Focuses on practical application and real-world results",
          "tier": 2,
          "indicators": [
            "Cared about what works",
            "Wanted to see results",
            "Focused on practical solutions",
            "Preferred action over theory",
            "Learned by doing",
            "Applied knowledge to real situations"
          ],
          "levels": [
            "Emerging",
            "Developing",
            "Strong",
            "Exceptional"
