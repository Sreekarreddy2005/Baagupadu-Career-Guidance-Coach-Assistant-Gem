{
  "name": "Trait Framework — Baagupadu",
  "version": "2.0",
  "description": "Defines all traits, indicators, and confidence scoring rules for identifying user patterns across life stages. Includes 3-Tiered Inference Model (Surface Behaviors → Core Traits → Identity Drivers), Shadow Traits with validation prompts, cultural modifiers, and composite career mapping.",
  "trait_categories": {
    "social_traits": {
      "name": "Social Traits",
      "description": "How the user interacts with others",
      "cultural_modifiers": {
        "note": "In Telugu/Indian context, behaviors like silence, family orientation, and deference to elders may indicate respect and collectivism, not weakness or low communication.",
        "apply_to": [
          "communication",
          "leadership",
          "teamwork"
        ]
      },
      "traits": {
        "leadership": {
          "name": "Leadership",
          "description": "Takes initiative, guides others, inspires action",
          "tier": 2,
          "indicators": [
            "Naturally took charge in childhood groups",
            "Sought responsibility in teen years",
            "Organized activities or teams",
            "Mentored others without being asked",
            "Challenged authority constructively",
            "People naturally looked to them for direction",
            "Led projects or initiatives at work"
          ],
          "cultural_note": "In collectivist cultures, leadership may be expressed through service and family responsibility, not just individual authority.",
          "levels": [
            "Emerging",
            "Developing",
            "Strong",
            "Exceptional"
          ],
          "career_affinities": [
            "Management",
            "Entrepreneurship",
            "Project Management",
            "Leadership"
          ],
          "validation_prompts": [
            "I notice you naturally take charge in groups. Where do you think that comes from?",
            "When people look to you for direction, how does that feel?"
          ]
        },
        "communication": {
          "name": "Communication",
          "description": "Expresses thoughts clearly, persuades, listens actively",
          "tier": 2,
          "indicators": [
            "Was good at explaining things",
            "People came to them for advice",
            "Comfortable speaking in groups",
            "Listened more than they spoke",
            "Could adapt communication to the audience",
            "Resolved conflicts through discussion"
          ],
          "cultural_note": "In Indian contexts, silence or indirect communication may indicate respect, not lack of communication skill.",
          "styles": [
            "Assertive",
            "Collaborative",
            "Empathetic",
            "Direct",
            "Persuasive"
          ],
          "career_affinities": [
            "Teaching",
            "Sales",
            "HR",
            "Coaching",
            "Public Relations"
          ],
          "validation_prompts": [
            "How do you feel when you need to speak up in a group?",
            "Do you prefer direct or indirect communication?"
          ]
        },
        "empathy": {
          "name": "Empathy",
          "description": "Understands others' feelings, shows compassion",
          "tier": 2,
          "indicators": [
            "Noticed when others were upset",
            "Helped friends who were struggling",
            "Considered others' feelings before acting",
            "Cared about how others felt",
            "Stood up for others",
            "Showed kindness to those who were left out"
          ],
          "levels": [
            "Emerging",
            "Developing",
            "Strong",
            "Exceptional"
          ],
          "career_affinities": [
            "Counseling",
            "Healthcare",
            "Teaching",
            "Social Work",
            "HR"
          ],
          "validation_prompts": [
            "When someone is struggling, how do you usually respond?",
            "Do you find yourself absorbing others' emotions?"
          ]
        },
        "teamwork": {
          "name": "Teamwork",
          "description": "Collaborates effectively, values group harmony",
          "tier": 2,
          "indicators": [
            "Enjoyed working in groups",
            "Was the one who kept the team together",
            "Shared credit with others",
            "Helped others succeed",
            "Could work with different personality types",
            "Put group goals above personal goals"
          ],
          "cultural_note": "In Indian contexts, strong family and group orientation may indicate healthy collectivism, not lack of independence.",
          "levels": [
            "Emerging",
            "Developing",
            "Strong",
            "Exceptional"
          ],
          "career_affinities": [
            "Operations",
            "Project Management",
            "Sports Management",
            "Event Planning"
          ],
          "validation_prompts": [
            "When working in a team, what role do you naturally take?",
            "How do you handle disagreements within a group?"
          ]
        }
      }
    },
    "cognitive_traits": {
      "name": "Cognitive Traits",
      "description": "How the user thinks, processes information, and approaches problems",
      "traits": {
        "analytical_thinking": {
          "name": "Analytical Thinking",
          "description": "Breaks down complex problems, seeks logic and patterns",
          "tier": 2,
          "indicators": [
            "Loved figuring out how things work",
            "Needed to understand the details",
            "Thought carefully before acting",
