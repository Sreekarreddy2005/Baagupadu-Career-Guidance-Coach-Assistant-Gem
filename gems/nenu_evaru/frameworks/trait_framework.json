        },
        "big_picture_orientation": {
          "name": "Big-Picture Orientation",
          "description": "Focuses on the broader vision and long-term goals",
          "tier": 2,
          "indicators": [
            "Wanted to see the whole picture",
            "Planned for the future",
            "Connected dots across different areas",
            "Was less concerned with minor details",
