          "career_affinities": [
            "Operations",
            "Engineering",
            "Construction",
            "Management"
          ],
          "validation_prompts": [
            "Do you prefer practical solutions or theoretical ideas?",
            "How do you approach learning something new?"
          ]
        }
      }
    },
