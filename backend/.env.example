# Environment Variables for Baagupadu AI Backend

# The LLM Provider to use. Options: openai, gemini, anthropic
LLM_PROVIDER=openai

# API Keys (Fill in the one you are using)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
